# .env.example → কপি করে .env বানান, তারপর ভ্যালু বসান।
#   cp .env.example .env
#
# Docker Compose এই ফাইলটি স্বয়ংক্রিয়ভাবে পড়ে (ভ্যারিয়েবল ইন্টারপোলেশনের জন্য)।
# ⚠️ .env কখনো কমিট করবেন না — এতে ক্রেডেনশিয়াল থাকে (`.gitignore`-এ আছে)।

# ---------- আপস্ট্রিম Xtream সার্ভার ----------
XTREAM_BASE_URL=http://source-server.com:8080
XTREAM_USERNAME=your_username
XTREAM_PASSWORD=your_password

# ---------- হোস্ট পোর্ট ম্যাপিং ----------
# কনটেইনার-ভিতরে প্রক্সি সবসময় 8000-এ চলে; নিচের ভ্যালু হোস্টের দিকের পোর্ট
XTREAM_HOST_PORT=8000

# ডেমো প্রোফাইলের জন্য: docker compose --profile demo up -d --build
XTREAM_DEMO_HOST_PORT=8100
XTREAM_SIM_HOST_PORT=9000
