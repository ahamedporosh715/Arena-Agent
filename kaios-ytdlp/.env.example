# KaiOS 2.5 yt-dlp backend config
HOST=0.0.0.0
PORT=8080
HOST_PORT=8080
DOWNLOAD_DIR=/app/downloads

# Optional: protect API with a token. For hosted build, put same token in static/config.js or app Settings.
# Generate one: openssl rand -hex 24
YTDLP_ACCESS_TOKEN=

# Raw API manifest. Put a GitHub raw URL here if you want server-side API config auto-reload.
API_MANIFEST_PATH=/app/api.raw.json
API_MANIFEST_URL=
API_MANIFEST_REFRESH_SECONDS=3600
INNERTUBE_BOOTSTRAP_TTL_SECONDS=3600

# yt-dlp auto-update. Docker image uses /app/bin/yt-dlp so self-update can work.
YTDLP_BIN=/app/bin/yt-dlp
YTDLP_AUTO_UPDATE=1
YTDLP_UPDATE_CHANNEL=stable
YTDLP_UPDATE_INTERVAL_SECONDS=43200
FFMPEG_LOCATION=

# Tuning
MAX_CONCURRENT=2
METADATA_TIMEOUT_SECONDS=45
JOB_TIMEOUT_SECONDS=1800
CLEANUP_AFTER_SECONDS=86400
CORS_ORIGIN=*
